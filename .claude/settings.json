      "Bash(git push --follow-tags:*)",
      "Bash(git push origin v*:*)",
      "PowerShell(claude --bg:*)",
      "PowerShell(claude --background:*)",
      "PowerShell(node scripts/lanes/queue.mjs:*)",
      "PowerShell(node ./scripts/lanes/queue.mjs:*)",
      "PowerShell(node scripts\\lanes\\queue.mjs:*)",
      "PowerShell(node .\\scripts\\lanes\\queue.mjs:*)",
      "PowerShell(node scripts/lanes/start.mjs:*)",
      "PowerShell(node ./scripts/lanes/start.mjs:*)",
