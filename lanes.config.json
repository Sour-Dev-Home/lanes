{
  "requiredChecks": ["verify", "security", "lanes/gate"],
  "metrics": { "mainWorkflow": "verify.yml", "fragmentsDir": null },
  "dependabot": { "actionBumps": true },
  "health": { "approvedStuckMinutes": 30, "noProgressMinutes": 30, "gateFailureMinutes": 10 },
  "budget": { "perNightTokens": 300000000, "perLaneTokens": 15000000 },
  "identity": { "profile": "team", "app": { "id": 5140388, "installationId": 166641484, "botLogin": "sour-dev-lanes[bot]" } },
  "start": {
    "maxLanes": 8,
    "softPaths": ["^docs/USING\\.md$", "^README\\.md$", "^lanes\\.config\\.json$"],
    "models": { "skip": "sonnet", "quick": "sonnet", "full": "sonnet" }
  },
  "modules": {
    "entries": [
      { "id": "preflight", "paths": ["scripts/preflight.", "scripts/security-workflow."], "imports": [], "risk": "normal" },
      { "id": "modules", "paths": ["scripts/lanes/modules.", "scripts/lanes/affected-tests.", "scripts/lanes/scope-tests.", "contracts/module-map."], "imports": [], "contracts": ["contracts/module-map."], "risk": "normal" },
      { "id": "structure", "paths": ["scripts/lanes/structure-report."], "imports": ["modules"], "risk": "sensitive" },
      { "id": "lessons", "paths": ["scripts/lanes/lessons."], "imports": ["modules"], "risk": "sensitive" },
      { "id": "lib", "paths": ["scripts/lanes/lib.", "scripts/lanes/validate."], "imports": ["modules"], "risk": "sensitive" },
      { "id": "vendor", "paths": ["scripts/lanes/vendor."], "imports": [], "risk": "sensitive" },
      {
        "id": "gate",
        "paths": [
          "scripts/lanes/gate.", "scripts/lanes/gate-decision.", "scripts/lanes/blockers.",
          "scripts/lanes/post-review.", "scripts/lanes/issue-contract.", "scripts/lanes/reviewers.", "scripts/lanes/contracts.",
          "scripts/lanes/workflow.", "scripts/gate-workflow.", "scripts/dashboard-workflow.", "scripts/dashboard.", "scripts/dashboard-visual."
        ],
        "imports": ["lib", "preflight"],
        "contracts": ["contracts/dashboard-visual."],
        "risk": "normal"
      },
      {
        "id": "queue",
        "paths": [
          "scripts/lanes/pick.", "scripts/lanes/status.", "scripts/lanes/paths.", "scripts/lanes/start.",
          "scripts/lanes/queue.", "scripts/lanes/cleanup.", "scripts/lanes/reap.", "scripts/lanes/lifecycle.",
          "scripts/lanes/snapshot.", "scripts/lanes/health.", "scripts/lanes/lane-cost.", "scripts/lanes/consolidate.",
          "scripts/lanes/app-token.", "scripts/lanes/identity-check.", "scripts/lanes/handover.", "scripts/lanes/test-retry.", "scripts/lanes/control."
        ],
        "imports": ["lib", "gate"],
        "contracts": ["contracts/snapshot."],
        "risk": "sensitive"
      },
      { "id": "workflow-apply", "paths": ["scripts/lanes/workflow-apply."], "imports": ["lib"], "risk": "sensitive" },
      {
        "id": "metrics",
        "paths": ["scripts/lanes/delivery-metrics.", "scripts/lanes/review-metrics.", "scripts/lanes/lane-metrics.", "scripts/lanes/diff-coverage.", "scripts/lanes/graphql-lib."],
        "imports": ["lib", "queue"],
        "contracts": ["contracts/review-metrics.", "contracts/lane-metrics."],
        "risk": "sensitive"
      },
      {
        "id": "install",
        "paths": ["scripts/lanes/install.", "scripts/lanes/upgrade.", "scripts/lanes/new-project.", "scripts/lanes/setup-repo.", "scripts/lanes/notify-hook.", "scripts/lanes/release.", "scripts/lanes/adopter-smoke.", "scripts/lanes/app-setup.", "scripts/lanes/setup-state.", "scripts/lanes/init."],
        "imports": ["lib", "preflight", "queue"],
        "contracts": ["contracts/lanes-lock."],
        "risk": "sensitive"
      }
    ],
    "allowCycles": []
  },
  "paths": {
    "skip": ["^docs/", "\\.md$", "\\.test\\.m?[jt]sx?$", "(^|/)__tests__/", "(^|/)test/"],
    "contract": ["^contracts/", "\\.schema\\.json$", "(^|/)schema\\.ts$"],
    "sensitive": [
      "^\\.github/",
      "^\\.claude/",
      "^\\.githooks/",
      "^scripts/lanes/",
      "^scripts/preflight\\.mjs$",
      "^lanes\\.config\\.json$",
      "(^|/)auth/",
      "(^|/)secrets?/",
      "^deploy/",
      "^dashboard/",
      "(^|/)\\.env",
      "^package(-lock)?\\.json$",
      "(^|/)(pnpm-lock\\.yaml|yarn\\.lock)$",
      "^vendor/",
      "(^|/)CLAUDE\\.md$",
      "^\\.gitattributes$"
    ],
    "ui": ["^frontend/src/", "^src/ui/", "\\.css$", "^dashboard/"],
    "owner": []
  }
}
