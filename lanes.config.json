{
  "requiredChecks": ["verify", "security", "lanes/gate"],
  "metrics": { "mainWorkflow": "verify.yml", "fragmentsDir": null },
  "start": {
    "maxLanes": 8,
    "softPaths": ["^docs/USING\\.md$", "^README\\.md$"],
    "models": { "skip": "sonnet", "quick": "sonnet", "full": "sonnet" }
  },
  "modules": {
    "entries": [
      { "id": "preflight", "paths": ["scripts/preflight.", "scripts/security-workflow."], "imports": [] },
      { "id": "modules", "paths": ["scripts/lanes/modules."], "imports": [] },
      { "id": "structure", "paths": ["scripts/lanes/structure-report."], "imports": ["modules"] },
      { "id": "lessons", "paths": ["scripts/lanes/lessons."], "imports": ["modules"] },
      { "id": "lib", "paths": ["scripts/lanes/lib.", "scripts/lanes/validate."], "imports": [] },
      { "id": "vendor", "paths": ["scripts/lanes/vendor."], "imports": [] },
      {
        "id": "gate",
        "paths": [
          "scripts/lanes/gate.", "scripts/lanes/gate-decision.", "scripts/lanes/blockers.", "scripts/lanes/approve-guard.", "scripts/lanes/shell-lex.",
          "scripts/lanes/post-review.", "scripts/lanes/issue-contract.", "scripts/lanes/reviewers.", "scripts/lanes/contracts.",
          "scripts/lanes/workflow.", "scripts/gate-workflow.", "scripts/dashboard-workflow.", "scripts/dashboard."
        ],
        "imports": ["lib", "preflight"]
      },
      {
        "id": "queue",
        "paths": [
          "scripts/lanes/pick.", "scripts/lanes/status.", "scripts/lanes/paths.", "scripts/lanes/start.", "scripts/lanes/start-guard.",
          "scripts/lanes/queue.", "scripts/lanes/cleanup.", "scripts/lanes/reap.", "scripts/lanes/lifecycle.",
          "scripts/lanes/snapshot.", "scripts/lanes/lane-cost."
        ],
        "imports": ["lib", "gate"]
      },
      {
        "id": "metrics",
        "paths": ["scripts/lanes/delivery-metrics.", "scripts/lanes/review-metrics.", "scripts/lanes/lane-metrics.", "scripts/lanes/diff-coverage."],
        "imports": ["lib", "queue"]
      },
      {
        "id": "install",
        "paths": ["scripts/lanes/install.", "scripts/lanes/new-project.", "scripts/lanes/setup-repo.", "scripts/lanes/notify-hook."],
        "imports": ["lib", "preflight"]
      }
    ],
    "allowCycles": []
  },
  "paths": {
    "skip": ["^docs/", "\\.md$", "\\.test\\.m?[jt]sx?$", "(^|/)__tests__/", "(^|/)test/"],
    "contract": ["^contracts/", "\\.schema\\.json$", "(^|/)schema\\.ts$"],
    "sensitive": [
      "^\\.github/",
      "^\\.claude/",
      "^\\.githooks/",
      "^scripts/lanes/",
      "^scripts/preflight\\.mjs$",
      "^lanes\\.config\\.json$",
      "(^|/)auth/",
      "(^|/)secrets?/",
      "^deploy/",
      "^dashboard/",
      "(^|/)\\.env",
      "^package(-lock)?\\.json$",
      "(^|/)(pnpm-lock\\.yaml|yarn\\.lock)$",
      "^vendor/",
      "(^|/)CLAUDE\\.md$",
      "^\\.gitattributes$"
    ],
    "ui": ["^frontend/src/", "^src/ui/", "\\.css$", "^dashboard/"],
    "owner": [
      "^scripts/lanes/(gate|lib|approve-guard|post-review|issue-contract)(\\.test)?\\.mjs$",
      "^scripts/lanes/gate-decision\\.test\\.mjs$",
      "^scripts/lanes/workflow\\.test\\.mjs$",
      "^scripts/gate-workflow\\.test\\.mjs$",
      "^scripts/lanes/contracts\\.test\\.mjs$",
      "^scripts/lanes/start-guard(\\.test)?\\.mjs$",
      "^scripts/lanes/shell-lex(\\.test)?\\.mjs$",
      "^scripts/lanes/(install|setup-repo|new-project)(\\.test)?\\.mjs$",
      "^\\.claude/settings\\.json$",
      "^\\.github/",
      "^\\.githooks/",
      "^lanes\\.config\\.json$",
      "^\\.claude/agents/",
      "^\\.claude/commands/(lane|night|approve)\\.md$",
      "^docs/adr/",
      "^package(-lock)?\\.json$",
      "(^|/)(pnpm-lock\\.yaml|yarn\\.lock)$",
      "^vendor/",
      "(^|/)CLAUDE\\.md$",
      "^\\.gitattributes$",
      "^scripts/preflight\\.mjs$",
      "(^|/)\\.env",
      "(^|/)auth/",
      "(^|/)secrets?/",
      "^deploy/"
    ]
  }
}
